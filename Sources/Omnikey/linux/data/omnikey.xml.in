<?xml version="1.0" encoding="utf-8"?>
<component>
	<name>org.freedesktop.IBus.Omnikey</name>
	<description>Omnikey Vietnamese input method</description>
	<exec>@OMNIKEY_ENGINE_PATH@ --ibus</exec>
	<version>@PROJECT_VERSION@</version>
	<author>Mai Vu Tuyen</author>
	<license>GPL-3.0</license>
	<homepage>https://github.com/jetaudio/Omnikey</homepage>
	<textdomain>omnikey</textdomain>
	<engines>
		<engine>
			<name>omnikey</name>
			<language>vi</language>
			<license>GPL-3.0</license>
			<author>Mai Vu Tuyen</author>
			<icon>@OMNIKEY_ICON_PATH@</icon>
			<layout>us</layout>
			<longname>Omnikey</longname>
			<description>Bộ gõ tiếng Việt Omnikey</description>
			<rank>99</rank>
			<symbol>V</symbol>
			<setup>@OMNIKEY_SETUP_PATH@</setup>
		</engine>
	</engines>
</component>
